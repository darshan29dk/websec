# ===================================================================
# GLOBALSHIELD SECURITY PLATFORM TEMPLATE ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure local secrets before running.
# ===================================================================

# Frontend Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_API_BASE_URL=http://localhost:8081/api/v1
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_SENDER=darshanreddy5822@gmail.com
VITE_SHA_KEY=your_sha_secret_key

# SMTP Mail Server Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=darshanreddy5822@gmail.com
SPRING_MAIL_PASSWORD=your_email_app_password
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true

# Security SHA-512 & JWT Secret Key Configuration
SHA_KEY=your_sha_secret_key
JWT_SECRET=your_jwt_secret_key
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Backend Server Configuration
SERVER_PORT=8081

# Database Configuration (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/globalshield
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# Lab Mode & AI Configuration
GLOBALSHIELD_LAB_MODE=true
AI_ENABLED=true
AI_PROVIDER=mock
